# Copy to .env.lrm and fill in values before deploying. Never commit .env.lrm.
# Use the public HTTPS origin of the VPS, without a trailing slash.
PUBLIC_URL=https://social.example.com
# Generate each secret independently, for example with: openssl rand -hex 32
JWT_SECRET=
POSTGRES_PASSWORD=
TEMPORAL_POSTGRES_PASSWORD=

# Meta: Instagram with Facebook Login, Instagram Login, and Threads.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=

# TikTok personal and business account integrations.
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_BUSINESS_CLIENT_ID=
TIKTOK_BUSINESS_CLIENT_SECRET=
